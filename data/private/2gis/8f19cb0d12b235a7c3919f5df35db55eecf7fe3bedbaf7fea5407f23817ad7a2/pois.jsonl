{"id":"2gis:70000001019586912","latest_version":"165622f982c9314afa107d36c320a7b364039ba63b32f03163fe23d3644da13b","versions":[{"fields":{"address":null,"adm_div":[{"id":"4","name":"Казахстан","type":"country"},{"id":"70030076149164503","name":"Астана","type":"region"},{"city_alias":"astana","flags":{"is_default":true,"is_region_center":true},"id":"9570771978420226","is_default":true,"name":"Астана","type":"city"},{"id":"9570759093518340","name":"Есиль район","type":"district"},{"detailed_subtype":"microdistrict","id":"9570810633125912","name":"Шубар м-н","type":"living_area"}],"coordinates":{"lat":51.136422,"lon":71.43867},"demo_eligible":false,"eligibility_note":"member_2_contract_pending","id":"2gis:70000001019586912","name":"Жетісу, парк","schedule":null,"source_description":"Жетысу (каз. Жетісу), бывший парк Арай — парк в Есильском районе Астаны. Реконструирован в 2018 году. Название по казахскому названию Семиречья, географической области в Центральной Азии.\nПарк с юга ограничен улицей Сарайшык, с востока рекой Ишим, с запада и севера микрорайоном Чубары.","source_id":"70000001019586912","source_rubrics":[{"alias":"parki","id":"168","kind":"primary","name":"Парки","parent_id":"2","short_id":168}],"source_type":"branch"},"provenance":[{"collected_at":"2026-10-18T15:17:16.148567+00:00","field_provenance":"All fields in this version come from this response/item; null denotes unknown","item_index":3,"locale":"ru_KZ","manifest_sha256":"5b91a4d353a6f40f83f2e0396d379e032e4495e12c987f61e2739493f6f1b1b6","request_fingerprint":"208a83ae78f41e87126d9a903fdf1a9eb59a159b415c5b64295c540f57cb4b8f","response":"data\\raw\\2gis\\qadam-2gis-v1\\responses\\208a83ae78f41e87126d9a903fdf1a9eb59a159b415c5b64295c540f57cb4b8f.json"}],"sha256":"165622f982c9314afa107d36c320a7b364039ba63b32f03163fe23d3644da13b"}]}
{"id":"2gis:70000001019586971","latest_version":"6a9a774ec1a0f20a623ceae6c66d4c4d1a22bc42e12800934fb58a2eceb6b641","versions":[{"fields":{"address":null,"adm_div":[{"id":"4","name":"Казахстан","type":"country"},{"id":"70030076149164503","name":"Астана","type":"region"},{"city_alias":"astana","flags":{"is_default":true,"is_region_center":true},"id":"9570771978420226","is_default":true,"name":"Астана","type":"city"},{"id":"70030076552180178","name":"Нура район","type":"district"}],"coordinates":{"lat":51.131725,"lon":71.408708},"demo_eligible":false,"eligibility_note":"member_2_contract_pending","id":"2gis:70000001019586971","name":"Ғашықтар, парк","schedule":null,"source_description":"Парк влюбленных «Жастар саябағы» создан в 2005г. В центре парка вы можете увидеть скульптуру «Бакытым менин» (Мое счастье) Ерболата Толепбая, где автор воплотил самые нежные чувства, молодых влюбленных. В 2006 году в парке была открыта фонтанная композиция Габриэлы фон Габсбург, состоящей из 16 подков, изображающих четыре лошади, бегущих в четыре стороны света, тем самым, напоминая о том, что Казахстан развивается во всех направлениях света, открыт всему миру, подковы установлены на символическом колесе - это объединение всех наций в их движении вперед. В парке стоит композиция «Алтын журек», символизирующая милосердие, помощь больным, детям-инвалидам.","source_id":"70000001019586971","source_rubrics":[{"alias":"parki","id":"168","kind":"primary","name":"Парки","parent_id":"2","short_id":168}],"source_type":"branch"},"provenance":[{"collected_at":"2026-10-18T15:17:16.148567+00:00","field_provenance":"All fields in this version come from this response/item; null denotes unknown","item_index":9,"locale":"ru_KZ","manifest_sha256":"5b91a4d353a6f40f83f2e0396d379e032e4495e12c987f61e2739493f6f1b1b6","request_fingerprint":"208a83ae78f41e87126d9a903fdf1a9eb59a159b415c5b64295c540f57cb4b8f","response":"data\\raw\\2gis\\qadam-2gis-v1\\responses\\208a83ae78f41e87126d9a903fdf1a9eb59a159b415c5b64295c5